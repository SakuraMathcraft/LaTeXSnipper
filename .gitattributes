.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.spec text eol=lf
requirements*.txt text eol=lf
packaging/debian/DEBIAN/* text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.zip filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.pyd filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text

# Office plugin release installers.
Office_plugin/windows/release/LaTeXSnipperOffice_*_windows_x86_64.exe filter=lfs diff=lfs merge=lfs -text
Office_plugin/macos/release/LaTeXSnipperOffice_*_macos_arm64.dmg filter=lfs diff=lfs merge=lfs -text

# Preserve upstream-distributed vendor runtime contents verbatim.
Office_plugin/shared/EditorAssets/vendor/mathlive.min.mjs -whitespace
Office_plugin/shared/EditorAssets/vendor/mathlive.LICENSE.txt -whitespace
src/assets/MathJax/** -text -whitespace
scripts/mathjax/liteDOM.js -text -whitespace
scripts/mathjax/office.props -text
