#include <windows.h>

#if !defined(LATEXSNIPPER_VERSION_MAJOR) || !defined(LATEXSNIPPER_VERSION_MINOR) || !defined(LATEXSNIPPER_VERSION_PATCH)
#error LaTeXSnipper product version macros are required
#endif

#define LATEXSNIPPER_STRINGIZE_VALUE(value) #value
#define LATEXSNIPPER_STRINGIZE(value) LATEXSNIPPER_STRINGIZE_VALUE(value)
#define LATEXSNIPPER_VERSION_TEXT \
    LATEXSNIPPER_STRINGIZE(LATEXSNIPPER_VERSION_MAJOR) "." \
    LATEXSNIPPER_STRINGIZE(LATEXSNIPPER_VERSION_MINOR) "." \
    LATEXSNIPPER_STRINGIZE(LATEXSNIPPER_VERSION_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LATEXSNIPPER_VERSION_MAJOR,LATEXSNIPPER_VERSION_MINOR,LATEXSNIPPER_VERSION_PATCH,0
 PRODUCTVERSION LATEXSNIPPER_VERSION_MAJOR,LATEXSNIPPER_VERSION_MINOR,LATEXSNIPPER_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SakuraMathcraft"
            VALUE "FileDescription", "LaTeXSnipper OLE Formula Object Handler"
            VALUE "FileVersion", LATEXSNIPPER_VERSION_TEXT
            VALUE "InternalName", "LaTeXSnipper.OfficePlugin.OleFormulaObject.Handler"
            VALUE "OriginalFilename", "LaTeXSnipper.OfficePlugin.OleFormulaObject.Handler.dll"
            VALUE "ProductName", "LaTeXSnipper Office Plugin"
            VALUE "ProductVersion", LATEXSNIPPER_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
