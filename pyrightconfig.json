{
    "pythonVersion": "3.11",
    "pythonPlatform": "All",
    "typeCheckingMode": "basic",
    "include": [
        "src",
        "mathcraft_ocr",
        "scripts",
        "tools/mathjax"
    ],
    "extraPaths": [
        ".",
        "src",
        "scripts"
    ],
    "exclude": [
        "**/__pycache__",
        "build",
        "dist",
        "mathcraft_ocr/vendor",
        ".venv"
    ],
    "executionEnvironments": [
        {
            "root": "src/ui",
            "reportAttributeAccessIssue": "none",
            "reportOptionalMemberAccess": "none"
        },
        {
            "root": "src/handwriting",
            "reportOptionalMemberAccess": "none"
        },
        {
            "root": "src",
            "extraPaths": [
                ".",
                "scripts"
            ]
        },
        {
            "root": "mathcraft_ocr",
            "pythonVersion": "3.10"
        }
    ]
}
