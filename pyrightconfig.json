{
    "pythonVersion": "3.11",
    "pythonPlatform": "All",
    "typeCheckingMode": "standard",
    "include": [
        "src",
        "mathcraft_ocr",
        "scripts"
    ],
    "extraPaths": [
        ".",
        "src",
        "scripts/release"
    ],
    "exclude": [
        "**/__pycache__",
        "build",
        "dist",
        "mathcraft_ocr/vendor",
        ".venv"
    ],
    "executionEnvironments": [
        {
            "root": "src",
            "extraPaths": [
                ".",
                "scripts/release"
            ]
        },
        {
            "root": "mathcraft_ocr",
            "pythonVersion": "3.10"
        }
    ]
}
